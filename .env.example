# Supabase project
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Local PostgreSQL (npm run db:start or docker compose up -d)
DATABASE_URL=postgresql://appachas:appachas@127.0.0.1:54322/appachas
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false
APP_ENV=development
CRON_SECRET=replace-with-a-random-local-secret

# Optional: defaults below need no new secret for production domain migration.
# For a two-host local test, see docs/custom-domain.md; do not use HTTP in production.
MIGRATION_SOURCE_ORIGIN=https://appachas.vercel.app
MIGRATION_TARGET_ORIGIN=https://appachas.es
VITE_MIGRATION_SOURCE_ORIGIN=https://appachas.vercel.app
VITE_MIGRATION_TARGET_ORIGIN=https://appachas.es
